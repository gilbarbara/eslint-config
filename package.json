{
  "name": "@gilbarbara/eslint-config",
  "version": "1.2.3",
  "description": "Opinionated ESLint configuration for modern projects",
  "author": "Gil Barbara <gilbarbara@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilbarbara/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/gilbarbara/eslint-config/issues"
  },
  "homepage": "https://github.com/gilbarbara/eslint-config",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./base": "./src/base.js",
    "./node": "./src/node.js",
    "./react": "./src/react.js",
    "./testing-library": "./src/testing-library.js",
    "./type-checking": "./src/type-checking.js",
    "./vitest": "./src/vitest.js"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "eslint",
    "config",
    "javascript",
    "typescript",
    "react"
  ],
  "license": "MIT",
  "peerDependencies": {
    "eslint": "^10.4.0",
    "prettier": "3",
    "typescript": ">=5 <6.1",
    "vitest": "4 - 5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@eslint-react/kit": "^5.28.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@gilbarbara/prettier-config": "^1.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "repo-tools": "^0.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "lint": "eslint --fix src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "format": "prettier --write --log-level=warn \"**/*.{yml,json,md,css}\"",
    "validate": "pnpm run lint && pnpm run test:coverage",
    "prepare": "husky"
  },
  "prettier": "@gilbarbara/prettier-config"
}
